{
  "vector_version": 1,
  "connector": "playnite",
  "min_client_api": "1.0",
  "cases": [
    {
      "name": "day-precision release date keeps year, month and day",
      "record": "games/record-portal.json",
      "expect": {"Name": "Portal 2", "ReleaseDate": {"Year": 2011, "Month": 4, "Day": 19}, "Developers": ["Valve"]}
    },
    {
      "name": "unknown fields and unknown vocabulary values are ignored, never fatal",
      "record": "forward-compat/record-unknown-members.json",
      "expect": {"Name": "Forward Compatibility Probe", "ReleaseDate": {"Year": 2011, "Month": 4, "Day": 19}}
    }
  ]
}
